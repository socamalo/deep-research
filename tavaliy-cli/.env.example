# Tavily API Keys - Add multiple keys for automatic rotation
# The server will automatically rotate between keys based on the day of the month
# Format: TAVILY_API_KEY_1, TAVILY_API_KEY_2, etc.
TAVILY_API_KEY_1=your-tavily-api-key-1
TAVILY_API_KEY_2=your-tavily-api-key-2
TAVILY_API_KEY_3=your-tavily-api-key-3
TAVILY_API_KEY_4=your-tavily-api-key-4
TAVILY_API_KEY_5=your-tavily-api-key-5
TAVILY_API_KEY_6=your-tavily-api-key-6
